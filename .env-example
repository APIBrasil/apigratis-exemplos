# Credenciais da plataforma APIBrasil — https://apibrasil.com.br
# Copie para .env (que está no .gitignore) e preencha.
#
# Todas as SDKs oficiais leem estas variáveis automaticamente:
# um `new ApiBrasil()` sem argumentos já sai autenticado.

# JWT da sua conta. Vem do login (POST /api/v2/login) ou do painel → credenciais.
# Identifica VOCÊ. Obrigatório em todas as rotas autenticadas.
APIBRASIL_BEARER_TOKEN=

# Token do device. Identifica UMA INSTÂNCIA de um serviço device-based
# (uma sessão de WhatsApp, um device de SMS, de veículos...).
# Obrigatório em /whatsapp/*, /sms/*, /vehicles/*, /cep/*, /correios/* e afins.
# Não é usado nas consultas por crédito.
APIBRASIL_DEVICE_TOKEN=

# SecretKey da API. Usada SÓ para criar devices (POST /api/v2/devices/store).
# Painel → a API desejada → SecretKey.
APIBRASIL_SECRET_KEY=

# Base do gateway. Deixe em branco para usar produção.
# APIBRASIL_BASE_URL=https://gateway.apibrasil.io/api/v2

# ---------------------------------------------------------------------------
# Só para os exemplos de MCP (pasta mcp/)
# ---------------------------------------------------------------------------

# Servidor MCP da APIBrasil.
APIBRASIL_MCP_URL=https://mcp.apibrasil.cloud/mcp

# Token do próprio servidor MCP, se o deploy exigir (MCP_AUTH_TOKEN no servidor).
# Não confundir com o bearer da APIBrasil.
# APIBRASIL_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Só para os exemplos que fazem login por email/senha
# ---------------------------------------------------------------------------

# APIBRASIL_EMAIL=
# APIBRASIL_PASSWORD=
